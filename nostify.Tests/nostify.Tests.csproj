<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <GenerateTargetFrameworkAttribute>false</GenerateTargetFrameworkAttribute>
    <!--
      Test fixtures intentionally exercise obsolete compatibility APIs and favor
      descriptive underscore-separated names. Performance, globalization, and
      API-design analyzers target shipped production code and are not useful
      gates for this non-packable test assembly. Compiler correctness and xUnit
      diagnostics remain enabled.
    -->
    <NoWarn>$(NoWarn);CS0618;CS8600;CS8601;CS8602;CS8603;CS8604;CS8618;CS8625;CA1001;CA1016;CA1304;CA1305;CA1310;CA1311;CA1707;CA1711;CA1805;CA1816;CA1822;CA1825;CA1847;CA1852;CA1854;CA1859;CA1860;CA1861;CA1866;CA1873;CA2016;CA2022;IDE0028;IDE0037;SYSLIB1045</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="Microsoft.Extensions.Configuration.EnvironmentVariables" Version="10.0.1" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Json" Version="10.0.1" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.8.0" />
    <PackageReference Include="Moq" Version="4.20.72" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.5.3" />
    <PackageReference Include="MockQueryable.Moq" Version="3.1.1" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\nostify.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Make layered test settings available regardless of the test runner's working directory. -->
    <None Update="appsettings.json" CopyToOutputDirectory="PreserveNewest" />
    <None Update="local.appsettings.json" CopyToOutputDirectory="PreserveNewest" Condition="Exists('local.appsettings.json')" />
  </ItemGroup>

</Project>
