    <NoWarn>$(NoWarn);CA1016;CA1707;CA1812;CA1822;CA1852</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\nostify.csproj" />
  </ItemGroup>

</Project>
